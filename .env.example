# docker-compose용 환경 변수 (실제 사용 시 .env 로 복사해서 값 수정)
# map.steeljoon.test 로 접속하려면 80을 그대로 두세요. 80번 포트가 이미 다른 프로그램에서
# 쓰이고 있다면(IIS, Skype 등) 8080처럼 다른 값으로 바꾸고 URL에 포트를 붙여야 합니다.
APP_PORT=80
DB_PORT=3306
COMPOSE_PROJECT_NAME=dev_map
DB_DATABASE=dev_map
DB_USERNAME=map
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret
